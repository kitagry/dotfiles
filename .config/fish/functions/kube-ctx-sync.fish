function kube-ctx-sync --description "split kube contexts into \$KUBE_CTX_DIR/<alias>.yaml and generate wrapper completions"
    # usage:
    #   kube-ctx-sync [alias=]<context> ...   add / refresh the given contexts
    #   kube-ctx-sync                         refresh every context already split
    #   kube-ctx-sync --rm <alias> ...        remove split kubeconfig + completions
    #   kube-ctx-sync --list                  show alias -> context
    set -l dir $KUBE_CTX_DIR
    set -l comp_dir $dir/completions
    set -l bin_dir $dir/bin

    switch "$argv[1]"
        case -h --help
            echo "usage:"
            echo "  kube-ctx-sync [alias=]<context> ...   add / refresh the given contexts"
            echo "  kube-ctx-sync                         refresh every context already split"
            echo "  kube-ctx-sync --rm <alias> ...        remove split kubeconfig + completions"
            echo "  kube-ctx-sync --list                  show alias -> context"
            return 0
        case --list
            for cfg in $dir/*.yaml
                set -l alias (path basename $cfg | path change-extension '')
                printf '%s\t%s\n' $alias (__kube_ctx_sync_context_of $cfg)
            end
            return 0
        case --rm
            for alias in $argv[2..]
                rm -fv $dir/$alias.yaml $dir/$alias.env
                # Per-command paths, not `$alias-*`: that glob would also eat the files of
                # another alias that merely starts with "<alias>-" (e.g. foo vs foo-x).
                for cmd in $KUBE_CTX_CMDS
                    rm -fv $comp_dir/$alias-$cmd.fish $bin_dir/$alias-$cmd
                end
            end
            return 0
    end

    if not type -q kubectl
        echo "kube-ctx-sync: kubectl not found" >&2
        return 1
    end

    mkdir -p $comp_dir $bin_dir
    chmod 700 $dir

    # Build the alias=context list: explicit args, or re-derive from existing files.
    set -l specs $argv
    if test (count $specs) -eq 0
        for cfg in $dir/*.yaml
            set -l alias (path basename $cfg | path change-extension '')
            set -a specs "$alias="(__kube_ctx_sync_context_of $cfg | string collect)
        end
        if test (count $specs) -eq 0
            echo "kube-ctx-sync: nothing to sync. usage: kube-ctx-sync [alias=]<context> ..." >&2
            echo "available contexts:" >&2
            kubectl config get-contexts -o name | sed 's/^/  /' >&2
            return 1
        end
    end

    set -l failed 0
    for spec in $specs
        set -l alias (string split -m1 = $spec)[1]
        set -l ctx (string split -m1 = $spec)[-1]
        # The alias becomes a fish function name and a sed replacement, keep it boring.
        if not string match -qr '^[A-Za-z0-9_-]+$' $alias
            echo "kube-ctx-sync: alias '$alias' must match [A-Za-z0-9_-]+ (use alias=context to rename)" >&2
            set failed 1
            continue
        end

        set -l cfg $dir/$alias.yaml
        # --minify keeps only this context (and sets it as current-context inside the file),
        # --flatten inlines cert files so the result is self-contained.
        if not kubectl config view --minify --flatten --context $ctx >$cfg.tmp 2>/dev/null
            echo "kube-ctx-sync: context '$ctx' not found in kubeconfig" >&2
            rm -f $cfg.tmp
            set failed 1
            continue
        end
        chmod 600 $cfg.tmp
        mv $cfg.tmp $cfg
        echo "$alias -> $ctx"

        for cmd in $KUBE_CTX_CMDS
            type -q $cmd; or continue
            __kube_ctx_sync_wrapper $alias $cmd >$bin_dir/$alias-$cmd
            chmod 755 $bin_dir/$alias-$cmd
            __kube_ctx_sync_completion $alias $cmd >$comp_dir/$alias-$cmd.fish
            or begin
                echo "  skip completion for $cmd (no cobra-style 'completion fish')" >&2
                rm -f $comp_dir/$alias-$cmd.fish
            end
        end
    end

    # Make the wrappers callable in this shell right away (new shells get it from conf.d).
    fish_add_path -g -p $bin_dir

    set -l cur (kubectl config current-context 2>/dev/null)
    if test -n "$cur"
        echo
        echo "hint: ~/.kube/config still has current-context='$cur', so bare kubectl/k9s/flux use it."
        echo "      to force explicit contexts everywhere:  kubectl config unset current-context"
    end
    return $failed
end

function __kube_ctx_sync_context_of --argument-names cfg
    kubectl config view --kubeconfig $cfg -o jsonpath='{.contexts[0].name}'
end

function __kube_ctx_sync_wrapper --argument-names alias cmd
    # A plain sh executable rather than a fish function so it also works from
    # `watch`, `xargs`, tmux, bash (Claude's Bash tool), ... anything using `sh -c`.
    printf '%s\n' \
        '#!/bin/sh' \
        '# generated by kube-ctx-sync; edit the kubeconfig / .env next to it, not this file' \
        "d='$KUBE_CTX_DIR'" \
        "export KUBECONFIG=\"\$d/$alias.yaml\"" \
        "if [ -f \"\$d/$alias.env\" ]; then set -a; . \"\$d/$alias.env\"; set +a; fi" \
        "exec $cmd \"\$@\""
end

function __kube_ctx_sync_completion --argument-names alias cmd
    # cobra's fish completion is parameterised only by the program name, so
    # re-targeting it at the wrapper is a rename: `complete -c <alias>-<cmd>` and
    # `$args[1] __complete ...` then go through the wrapper (and its KUBECONFIG).
    # Internal helper names get an underscore prefix because fish forbids '-' in
    # variable names.
    set -l internal "__"(string replace -a -- - _ $alias-$cmd)"_"
    $cmd completion fish 2>/dev/null | sed \
        -e "s/__$cmd"'_/__KUBE_CTX_PFX_/g' \
        -e "s/$cmd/$alias-$cmd/g" \
        -e "s/__KUBE_CTX_PFX_/$internal/g"
    # pipestatus: fail only if the tool itself has no fish completion
    test $pipestatus[1] -eq 0
end
