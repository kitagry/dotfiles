# Per-context kube wrappers.
#
# Switching the global current-context is easy to get wrong, so instead every
# context gets its own kubeconfig under $KUBE_CTX_DIR (split by kube-ctx-sync)
# and wrappers that pin KUBECONFIG to it:
#
#   kc <ctx> <cmd> [args...]     # generic: kc pay-prod helm ls / kc pay-prod watch kubectl get pods
#   <ctx>-kubectl / <ctx>-k9s / <ctx>-flux   # e.g. pay-prod-kubectl get nodes
#
# The <ctx>-<cmd> wrappers are real executables in $KUBE_CTX_DIR/bin (not fish
# functions) so they also work from `watch`, `xargs`, tmux, bash, and anything
# else that spawns `sh -c`.
#
# Completions for the wrappers are generated by kube-ctx-sync into
# $KUBE_CTX_DIR/completions so that cluster-aware completions (namespaces,
# pod names, ...) query the pinned context instead of the ambient one.
# `--wraps` cannot do that: fish rewrites the command name back to the wrapped
# binary before running its completion, so the wrapper is bypassed.

set -q KUBE_CTX_DIR; or set -g KUBE_CTX_DIR $HOME/.kube/ctx
set -q KUBE_CTX_CMDS; or set -g KUBE_CTX_CMDS kubectl k9s flux

set -p fish_complete_path $KUBE_CTX_DIR/completions
fish_add_path -g -p $KUBE_CTX_DIR/bin

function __kube_ctx_names --description "aliases that have a split kubeconfig"
    path basename $KUBE_CTX_DIR/*.yaml | path change-extension ''
end

function kc --description "run a command pinned to one kube context: kc <ctx> <cmd> [args...]"
    if test (count $argv) -lt 2
        echo "usage: kc <ctx> <cmd> [args...]" >&2
        # string collect keeps the argument when there are no contexts yet
        # (an empty command substitution would swallow the whole echo argument).
        echo "contexts: "(__kube_ctx_names | string join ' ' | string collect) >&2
        return 2
    end
    set -l ctx $argv[1]
    set -l cfg $KUBE_CTX_DIR/$ctx.yaml
    if not test -f $cfg
        echo "kc: unknown context '$ctx' (add it with: kube-ctx-sync $ctx)" >&2
        return 1
    end
    set -l envs KUBECONFIG=$cfg
    # Optional extra env per context, one KEY=VALUE per line (e.g. AWS_PROFILE=...).
    if test -f $KUBE_CTX_DIR/$ctx.env
        set -a envs (string match -rv '^\s*(#|$)' <$KUBE_CTX_DIR/$ctx.env)
    end
    env $envs $argv[2..]
end

complete -c kc -f -n __fish_is_first_arg -a '(__kube_ctx_names)'
complete -c kc -n '__fish_is_nth_token 2' -a "$KUBE_CTX_CMDS"
